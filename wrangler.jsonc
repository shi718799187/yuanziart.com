{
  // ============================================================
  // Cloudflare Workers 部署配置（静态资源）
  // ------------------------------------------------------------
  // 站点的源码在仓库里，dist/ 不进版本库（见 .gitignore），
  // 由 Cloudflare 在云端先跑 `node build.js` 生成 dist/，
  // 再由 `npx wrangler deploy` 把 dist/ 作为静态资源上传。
  //
  // ⚠️ name 必须和 Cloudflare 控制台里的「Project name」完全一致，
  //    否则 wrangler 会去创建/更新另一个同名的 Worker，两边对不上。
  //    名称只允许字母、数字、连字符（不能有下划线或点）。
  //
  // ⚠️ 不要在云端构建时跑 build-fonts.js：它要联网抓 Google Fonts
  //    并覆盖字体文件。字体已经提交进仓库，构建只需要 build.js。
  // ============================================================
  "name": "yuanziart-com",
  "compatibility_date": "2026-09-17",

  "assets": {
    // 构建产物目录（相对仓库根目录）
    "directory": "./dist",
    // 未知路径回退到 dist/404.html —— 与 Cloudflare Pages 的行为一致
    "not_found_handling": "404-page"
  }
}
